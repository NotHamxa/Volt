    "name": "Restart Windows Explorer",
    "type": "commandConfirm",
    "appId": null,
    "path": "Stop-Process -Name explorer -Force\n# Windows usually restarts the shell by itself; only start it if it didn't.\nStart-Sleep -Seconds 2\nif (-not (Get-Process -Name explorer -ErrorAction SilentlyContinue)) { Start-Process explorer.exe }",
    "shell": "powershell",
    "source": "predefined"
