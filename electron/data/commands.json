  {
    "name": "Show Saved WiFi Passwords",
    "type": "commandConfirmOpen",
    "appId": null,
    "path": "netsh wlan show profiles | Select-String ':\\s*(.+)$' | ForEach-Object {\n    $name = $_.Matches.Groups[1].Value.Trim()\n    $key = netsh wlan show profile name=\"$name\" key=clear | Select-String 'Key Content\\W+:\\s*(.+)$'\n    [pscustomobject]@{ SSID = $name; Password = if ($key) { $key.Matches.Groups[1].Value.Trim() } else { '' } }\n} | Format-Table -AutoSize",
    "shell": "powershell",
    "source": "predefined"
  },
